import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;
    
    TreeNode(int val) {
        this.val = val;
    }
}

public class Main {

    // Changed parameter type to Map so it accepts TreeMap
    public static void preOrder(Map<Integer, List<Integer>> map, TreeNode root, int dist) {
        if (root == null) return;

        // map.putIfAbsent(dist, new ArrayList<>());
        // map.get(dist).add(root.val);
        if (!map.containsKey(dist)) {
          map.put(dist, new ArrayList<>());
        }
        map.get(dist).add(root.val);
        preOrder(map, root.left, dist - 1);
        preOrder(map, root.right, dist + 1);
    }

    public static List<List<Integer>> getVerticalOrderOfTree(TreeNode root) {
        List<List<Integer>> ans = new ArrayList<>();
        
        // Use TreeMap instead of HashMap to keep horizontal distances automatically sorted from left to right
        Map<Integer, List<Integer>> map = new TreeMap<>();
        
        preOrder(map, root, 0);

        for (List<Integer> list : map.values()) {
            ans.add(list);
        }

        return ans;
    }

    public static void main(String[] args) {
        // Constructing the binary tree from the image:
        TreeNode root = new TreeNode(9);
        
        // Level 1
        root.left = new TreeNode(6);
        root.right = new TreeNode(4);
        
        // Level 2
        root.left.left = new TreeNode(2);
        root.left.right = new TreeNode(3);
        root.right.left = new TreeNode(8);
        root.right.right = new TreeNode(1);
        
        // Level 3
        root.left.left.left = new TreeNode(7);
        root.left.left.right = new TreeNode(11);
        root.left.right.left = new TreeNode(5);
        root.right.right.right = new TreeNode(12); 
        
        // Level 4
        root.left.left.left.left = new TreeNode(14); 
        root.left.right.left.right = new TreeNode(20); 
        
        // Level 5
        root.left.right.left.right.right = new TreeNode(31); 
        
        List<List<Integer>> result = getVerticalOrderOfTree(root);
        System.out.println("Vertical Order Traversal: " + result); 
    }
}
