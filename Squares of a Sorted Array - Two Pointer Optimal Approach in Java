Problem Statement
Given an integer array nums sorted in non-decreasing order, return an array of the squares of each number sorted in non-decreasing order.

Example 1:
Input: nums = [-2, 0, 1, 5]

Output: [0, 1, 4, 25]

Explanation: After squaring, the array becomes [4, 0, 1, 25]. Sorted in non-decreasing order, it becomes [0, 1, 4, 25].

Example 2:
Input: nums = [-7, -3, 2, 3, 11]

Output: [4, 9, 9, 49, 121]


import java.util.*;

public class Main {
    public static int[] sortedSquares(int[] nums) {
        // TODO: Write your code here
        int n = nums.length;
        int[] result = new int[n];

        int i = 0;
        int j = n-1;
        int k = j;

        while(i <= j) {
          int abs_i = nums[i] * nums[i];
          int abs_j = nums[j] * nums[j];

          if(abs_i < abs_j) {
            result[k] = abs_j;
            j--;
            k--;
          } else{
            result[k] = abs_i;
            i++;
            k--;
          }
        }

        return result;
    }

    public static void main(String[] args) {
        // Test Case 1
        int[] nums1 = {-2, 0, 1, 5};
        System.out.println("Input:  " + Arrays.toString(nums1));
        System.out.println("Output: " + Arrays.toString(sortedSquares(nums1)));
        System.out.println("Expected: [0, 1, 4, 25]\n");

        // Test Case 2
        int[] nums2 = {-7, -3, 2, 3, 11};
        System.out.println("Input:  " + Arrays.toString(nums2));
        System.out.println("Output: " + Arrays.toString(sortedSquares(nums2)));
        System.out.println("Expected: [4, 9, 9, 49, 121]");
    }
}
