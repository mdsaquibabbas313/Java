import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;

    // Constructor to initialize the node
    TreeNode(int val) {
        this.val = val;
        this.left = null;
        this.right = null;
    }
}

public class Main {
    public static TreeNode createBST(TreeNode root, int val) {
        // Base case: if root is null, create and return the new node with 'val'
        if (root == null) {
            return new TreeNode(val);
        }

        // Recursive insertion based on BST property
        if (val <= root.val) {
            root.left = createBST(root.left, val);
        } else {
            root.right = createBST(root.right, val);
        }

        return root;
    }

    public static void main(String[] args) {
        TreeNode root = null;
        int[] values = {5, 3, 7, 2, 4, 6, 8};

        // Insert each value into the BST
        for (int val : values) {
            root = createBST(root, val);
        }

        System.out.println("BST created successfully!");
        System.out.println("Root value: " + root.val);
        System.out.println("Left child of root: " + root.left.val);
        System.out.println("Right child of root: " + root.right.val);
    }
}
