import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;

    TreeNode(int val) {
        this.val = val;
        this.left = null;
        this.right = null;
    }
}

public class Main {
    
    // Problem: Given a Binary Tree and two nodes p and q, 
    // find their Lowest Common Ancestor (LCA).
    public static TreeNode lowestCommonAncestor(TreeNode root, TreeNode p, TreeNode q) {
        // TODO: Write your LCA logic here

        if(root == null) return null;

        if(root == p || root == q) return root;

        TreeNode getLCAFromLST = lowestCommonAncestor(root.left , p , q);

        TreeNode getLCAFromRST = lowestCommonAncestor(root.right , p , q);

        if(getLCAFromLST == null && getLCAFromRST == null) return null;

        if(getLCAFromLST == null) return getLCAFromRST;

        if(getLCAFromRST == null) return getLCAFromLST;

        return root;
        
    }

    public static void main(String[] args) {
        // Sample Binary Tree setup:
        //         3
        //       /   \
        //      5     1
        //     / \   / \
        //    6   2 0   8
        //       / \
        //      7   4
        TreeNode root = new TreeNode(3);
        root.left = new TreeNode(5);
        root.right = new TreeNode(1);
        root.left.left = new TreeNode(6);
        root.left.right = new TreeNode(2);
        root.right.left = new TreeNode(0);
        root.right.right = new TreeNode(8);
        root.left.right.left = new TreeNode(7);
        root.left.right.right = new TreeNode(4);

        // Let's test with nodes 5 and 4 (LCA should be 5)
        TreeNode p = root.left;              // Node 5
        TreeNode q = root.left.right.right;  // Node 4

        TreeNode lca = lowestCommonAncestor(root, p, q);
        
        if (lca != null) {
            System.out.println("LCA of " + p.val + " and " + q.val + " is: " + lca.val);
        } else {
            System.out.println("LCA not found.");
        }
    }
}
