// O(N^2) 
import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;

    TreeNode(int val) {
        this.val = val;
        this.left = null;
        this.right = null;
    }
}

public class Main {
    
    // Problem: Given the root of a binary tree, return the length of the diameter of the tree.
    // The diameter of a binary tree is the length of the longest path between any two nodes in a tree. 
    // This path may or may not pass through the root.

    public static int height(TreeNode root) {
      if(root == null) return -1;

      int heightLST = height(root.left);
      int heightRST = height(root.right);

      return 1 + Math.max(heightLST , heightRST);
    }
    public static int diameterOfBinaryTree(TreeNode root) {
        // TODO: Write your logic here.
        // Hint: Think about how the height of left and right subtrees at any node 
        // contribute to the longest path passing through that node, while tracking the maximum globally.

        if(root == null) return 0;

        int diameterOfLST = diameterOfBinaryTree(root.left);
        int diameterOfRST = diameterOfBinaryTree(root.right);
        int diameter = height(root.left) + height(root.right) + 2;
        return Math.max(diameter, Math.max(diameterOfLST, diameterOfRST));
      
    }

    public static void main(String[] args) {
        // Sample Binary Tree setup:
        //         1
        //       /   \
        //      2     3
        //     / \   
        //    4   5  
        TreeNode root = new TreeNode(1);
        root.left = new TreeNode(2);
        root.right = new TreeNode(3);
        root.left.left = new TreeNode(4);
        root.left.right = new TreeNode(5);

        int diameter = diameterOfBinaryTree(root);
        System.out.println("Diameter of Binary Tree: " + diameter);
    }
}


// O(N) : get treeInfo both at once by custom class

LEETCODE : 543. Diameter of Binary Tree

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
 class TreeInfo{
  int height;
  int diameter;

  TreeInfo(int h , int d) {
    height = h;
    diameter = d;
  }
}
class Solution {
        public static TreeInfo getTreeInfo(TreeNode root) {

      if(root == null) {
        return new TreeInfo(-1,-1);
      }
      TreeInfo lst = getTreeInfo(root.left);
      TreeInfo rst = getTreeInfo(root.right);
      int x = Math.max(lst.height , rst.height) + 1; // calculates height
      int y = Math.max(lst.height + rst.height + 2, Math.max(lst.diameter , rst.diameter)); // calculates diameter
      TreeInfo treeInfo = new TreeInfo( x , y );

      return treeInfo;
    }
    public int diameterOfBinaryTree(TreeNode root) {

        if(root == null) return -1;

      TreeInfo treeInfo = getTreeInfo(root);

      return treeInfo.diameter;
        
    }
}


// Splitted in Condition for Diameter


/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */

class TreeInfo{
    int height;
    int diameter;

    TreeInfo(int h , int d){
        this.height = h;
        this.diameter = d;
    }
} 
class Solution {
    public TreeInfo getTreeInfo(TreeNode root) {

        if(root == null) {
            return new TreeInfo(-1 , -1);
        }

        TreeInfo leftInfo = getTreeInfo(root.left);
        TreeInfo rightInfo = getTreeInfo(root.right);
        
        int height = Math.max(leftInfo.height , rightInfo.height) + 1;

        int condition1 = Math.max(leftInfo.diameter , rightInfo.diameter);
        int condition2 = leftInfo.height + rightInfo.height + 2;

        int diameter = Math.max(condition1 , condition2);

        return new TreeInfo(height , diameter);


    }
    public int diameterOfBinaryTree(TreeNode root) {

        if(root == null) {
            return -1;
        }
        TreeInfo treeInfo = getTreeInfo(root);

        return treeInfo.diameter;
    }
}
