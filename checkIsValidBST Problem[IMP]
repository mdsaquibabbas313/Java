import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;

    TreeNode(int val) {
        this.val = val;
        this.left = null;
        this.right = null;
    }
}
class BstInfo{
  boolean isBst;
  int max ;
  int min;
  BstInfo(boolean a , int b , int c) {
    this.isBst = a;
    this.max = b;
    this.min = c;
  }
}
public class Main {
    public static BstInfo getBstInfo(TreeNode root) {

      if(root == null) {
        return new BstInfo(true , Integer.MIN_VALUE , Integer.MAX_VALUE);
      }

      BstInfo leftInfo = getBstInfo(root.left);
      BstInfo rightInfo = getBstInfo(root.right);

      boolean isBst = leftInfo.isBst && rightInfo.isBst && 
                        (leftInfo.max < root.val && root.val < rightInfo.min);

      int mx = Math.max(root.val, Math.max(leftInfo.max, rightInfo.max));
      int mn = Math.min(root.val, Math.min(leftInfo.min, rightInfo.min));

      return new BstInfo(isBst , mx , mn);


    }
    public static boolean isValidBST(TreeNode root) {

      BstInfo bstInfo = getBstInfo(root);

      return bstInfo.isBst == true ? true : false;
      
    }

    public static void main(String[] args) {
        // Sample BST setup (Valid):
        //         2
        //       /   \
        //      1     3
        TreeNode root = new TreeNode(2);
        root.left = new TreeNode(1);
        root.right = new TreeNode(3);

        boolean isValid = isValidBST(root);
        System.out.println("Is Valid BST: " + isValid);
    }
}
