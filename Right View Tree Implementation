import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;
    
    TreeNode(int val) {
        this.val = val;
    }
}

public class Main {
    // Function to return the right view of a binary tree using BFS
    public static List<Integer> printRightViewOfTree(TreeNode root) {
        List<Integer> ans = new ArrayList<>();

        if(root == null) return ans;

        Queue<TreeNode> queue = new LinkedList<>();
        
        queue.offer(root);

        while(!queue.isEmpty()) {

            int queueSize = queue.size();

            for(int i = 0 ; i<queueSize ; i++) {
              
              TreeNode currentNode = queue.poll();
              if(i == queueSize - 1) ans.add(currentNode.val);

              if(currentNode.left != null) queue.offer(currentNode.left);

              if(currentNode.right != null) queue.offer(currentNode.right);

            }
        }


        return ans;
    }

    public static void main(String[] args) {
        // Constructing the binary tree from the image:
        TreeNode root = new TreeNode(9);
        
        // Level 1
        root.left = new TreeNode(6);
        root.right = new TreeNode(4);
        
        // Level 2
        root.left.left = new TreeNode(2);
        root.left.right = new TreeNode(3);
        root.right.left = new TreeNode(8);
        root.right.right = new TreeNode(1);
        
        // Level 3
        root.left.left.left = new TreeNode(7);
        root.left.left.right = new TreeNode(11);
        root.left.right.left = new TreeNode(5);
        root.right.right.right = new TreeNode(12); // from node 1 -> right child
        
        // Level 4
        root.left.left.left.left = new TreeNode(14); // from node 7 -> left child
        root.left.right.left.right = new TreeNode(20); // from node 5 -> right child
        
        // Level 5
        root.left.right.left.right.right = new TreeNode(31); // from node 20 -> right child
        
        List<Integer> result = printRightViewOfTree(root);
        System.out.println("Right View of Tree: " + result); 
        // Right View of Tree: [9, 4, 1, 12, 20, 31]
    }
}
