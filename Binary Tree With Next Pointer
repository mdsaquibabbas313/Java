import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;
    TreeNode next;

    TreeNode(int val) {
        this.val = val;
        left = null;
        right = null;
        next = null;
    }
}

public class Main {
    
    public static TreeNode getNextPointer(TreeNode root) {
        // Code your logic here
        if (root == null) return null;

        Queue<TreeNode> queue = new LinkedList<>();

        queue.offer(root);

        while(!queue.isEmpty()) {
          int size = queue.size();

          TreeNode prev = null;

          for(int i = 0 ; i<size; i++) {

            
            TreeNode curr = queue.poll();

            if(prev == null) {
              prev = curr;
            } else {
              prev.next = curr;
              prev = curr;
            }

            if(curr.left != null) {
            queue.offer(curr.left);
            }

            if(curr.right != null){
              queue.offer(curr.right);
            }

          }

          
        }
        
        return root;
    }
// Clean and easy print function using next pointers
    public static void printLevels(TreeNode root) {
        TreeNode currLevel = root;

        while (currLevel != null) {
            TreeNode curr = currLevel;
            TreeNode nextLevelHead = null;

            // Traverse horizontally using the 'next' pointer
            while (curr != null) {
                System.out.print(curr.val + " ");

                // Find the first node of the next level
                if (nextLevelHead == null) {
                    if (curr.left != null) {
                        nextLevelHead = curr.left;
                    } else if (curr.right != null) {
                        nextLevelHead = curr.right;
                    }
                }

                curr = curr.next;
            }
            System.out.println(); // Move to the next line for the next level
            currLevel = nextLevelHead;
        }
    }

    public static void main(String[] args) {
        System.out.println("Running test case for Populating Next Right Pointers...\n");

        // Constructing tree for Pre-order: 1, 2, 4, 5, 3, 6
        //       1
        //      / \
        //     2   3
        //    / \  /
        //   4   5 6
        
        TreeNode root = new TreeNode(1);
        root.left = new TreeNode(2);
        root.right = new TreeNode(3);
        root.left.left = new TreeNode(4);
        root.left.right = new TreeNode(5);
        root.right.left = new TreeNode(6);

        // Populate the next pointers
        getNextPointer(root);

        // Print to verify
        System.out.println("Levels using next pointers:");
        printLevels(root);
    }
}


