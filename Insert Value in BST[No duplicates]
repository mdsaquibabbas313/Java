import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;

    // Constructor to initialize the node
    TreeNode(int val) {
        this.val = val;
        this.left = null;
        this.right = null;
    }
}

public class Main {
    
    // Problem: Given a BST and a value, insert this value in BST 
    // such that BST doesn't lose its property (assume no duplicates).
    public static TreeNode insertIntoBST(TreeNode root, int val) {
        // TODO: Write your insertion logic here

        if(root == null) {
          return new TreeNode(val);
        }

        if(val <= root.val) {
          root.left = insertIntoBST(root.left , val);
        } else {
          root.right = insertIntoBST(root.right , val);
        }
        
        return root;
    }

    // Helper method to print the tree (Inorder traversal to verify BST order)
    public static void inorder(TreeNode root) {
        if (root == null) return;
        inorder(root.left);
        System.out.print(root.val + " ");
        inorder(root.right);
    }

    public static void main(String[] args) {
        // Initial BST setup
        TreeNode root = null;
        int[] initialValues = {4, 2, 7, 1, 3};
        
        for (int v : initialValues) {
            root = insertIntoBST(root, v);
        }

        System.out.print("BST Inorder before insertion: ");
        inorder(root);
        System.out.println();

        // Insert a new value
        int valToInsert = 5;
        root = insertIntoBST(root, valToInsert);

        System.out.print("BST Inorder after inserting " + valToInsert + ": ");
        inorder(root);
        System.out.println();
    }
}
