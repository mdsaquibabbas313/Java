import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;
    
    TreeNode(int val) {
        this.val = val;
    }
}

class NodeLevel {
    TreeNode node;
    int dist;

    NodeLevel(TreeNode node, int dist) {
        this.node = node;
        this.dist = dist;
    }
}

public class Main {

    public static List<Integer> levelOrderTopView(TreeNode root) {
        List<Integer> ans = new ArrayList<>();

        if(root == null) return ans;

        // Map<Integer , List<Integer>> map = new TreeMap<>();
        Map<Integer , Integer> map = new TreeMap<>();

        Queue<NodeLevel> queue = new LinkedList<>();

        NodeLevel node = new NodeLevel(root , 0);
        queue.offer(node);

        while(!queue.isEmpty()) {
          int size = queue.size();
          for(int i = 0 ; i<size ; i++) {

            NodeLevel currentNode = queue.poll();

            if (!map.containsKey(currentNode.dist)) {
                map.put(currentNode.dist, currentNode.node.val);
            }

            if(currentNode.node.left != null) {
              queue.offer(new NodeLevel(currentNode.node.left , currentNode.dist - 1));
            }

            if(currentNode.node.right != null) {
              queue.offer(new NodeLevel(currentNode.node.right , currentNode.dist + 1));
            }
          }
        }

        for(Integer i : map.values()) {
          ans.add(i);
        }
        return ans; 
    }

    public static void main(String[] args) {
        // Constructing the complete binary tree from the image:
        TreeNode root = new TreeNode(9);
        
        // Level 1
        root.left = new TreeNode(6);
        root.right = new TreeNode(4);
        
        // Level 2
        root.left.left = new TreeNode(2);
        root.left.right = new TreeNode(3);
        root.right.left = new TreeNode(8);
        root.right.right = new TreeNode(1);
        
        // Level 3
        root.left.left.left = new TreeNode(7);
        root.left.left.right = new TreeNode(11);
        root.left.right.left = new TreeNode(5);
        root.right.right.right = new TreeNode(12); 
        
        // Level 4
        root.left.left.left.left = new TreeNode(14); 
        root.left.right.left.right = new TreeNode(20); 
        
        // Level 5
        root.left.right.left.right.right = new TreeNode(31); 

        List<Integer> result = levelOrderTopView(root);
        System.out.println("Top View Order Traversal: " + result);
    }
}
