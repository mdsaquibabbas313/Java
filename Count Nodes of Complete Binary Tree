//  Approach 1 : O(N)

import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;

    // Added constructor to initialize node values easily
    TreeNode(int val) {
        this.val = val;
        this.left = null;
        this.right = null;
    }
}

public class Main {
    public static int countNodesOfCompleteBT(TreeNode root) {
        if (root == null) return 0;

        return 1 + countNodesOfCompleteBT(root.left) + countNodesOfCompleteBT(root.right);
    }

    public static void main(String[] args) {
        /*
                   1
                 /   \
                2     3
               / 
              4   
        */
        TreeNode root = new TreeNode(1);
        root.left = new TreeNode(2);
        root.right = new TreeNode(3);
        root.left.left = new TreeNode(4);

        int totalNodes = countNodesOfCompleteBT(root);
        System.out.println("Total nodes: " + totalNodes);
    }
}

Approach 2 : Less Than 0(N)

// TODO:
class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;

    TreeNode(int val) {
        this.val = val;
        this.left = null;
        this.right = null;
    }
}

public class Main {

    // Fast height check using a loop (O(log N)) without bitwise operators
    public static int getHeight(TreeNode node) {
        int h = 0;
        while (node != null) {
            h++;
            node = node.left;
        }
        return h;
    }

    public static int countNodesOfCompleteBT(TreeNode root) {
        if (root == null) return 0;

        int lst = getHeight(root.left); 
        int rst = getHeight(root.right); 

        int count = 1; // root node

        if (lst == rst) {
            // Left subtree is a full tree of height 'lst'
            // Nodes = root(1) + ((2^lst) - 1) + right recursive call
            count = count + (int) Math.pow(2, lst) - 1 + countNodesOfCompleteBT(root.right);
        } else {
            // Right subtree is a full tree of height 'rst'
            // Nodes = root(1) + ((2^rst) - 1) + left recursive call
            count = count + (int) Math.pow(2, rst) - 1 + countNodesOfCompleteBT(root.left);
        }

        return count;
    }

    public static void main(String[] args) {
        TreeNode root = new TreeNode(1);
        root.left = new TreeNode(2);
        root.right = new TreeNode(3);
        root.left.left = new TreeNode(4);
        root.left.right = new TreeNode(5);
        root.right.left = new TreeNode(6);

        int totalNodes = countNodesOfCompleteBT(root);
        System.out.println("Total nodes: " + totalNodes); // Output: 6
    }
}
