import java.util.*;

class TreeNode {
    int val;
    TreeNode left;  // Declare type for left child
    TreeNode right; // Declare type for right child
    
    TreeNode(int val) {
        this.val = val;
    }
}

public class Main {
    public static List<List<Integer>> printLevelOrderTraversal(TreeNode root) {
        List<List<Integer>> ans = new ArrayList<>(); // Initialize the outer list
        
        // Edge case: if tree is empty, return empty list
        if (root == null) {
            return ans;
        }

        Queue<TreeNode> queue = new LinkedList<>();
        queue.offer(root); // In Java Queue, use 'offer()' instead of 'push()'
        
        while (!queue.isEmpty()) { // Use isEmpty() method with parentheses
            int levelSize = queue.size(); // Number of nodes at the current level
            List<Integer> currentLevel = new ArrayList<>();
            
            for (int i = 0; i < levelSize; i++) {
                TreeNode n = queue.poll(); // Use poll() method with parentheses to remove and get front element
                currentLevel.add(n.val);   // Add the node's value to the current level list
                
                // Push left child if it exists
                if (n.left != null) {
                    queue.offer(n.left);
                }
                // Push right child if it exists
                if (n.right != null) {
                    queue.offer(n.right);
                }
            }
            // Add the completed level list to our final answer
            ans.add(currentLevel);
        }

        return ans;
    }

    public static void main(String[] args) {
        // Example usage:
        TreeNode root = new TreeNode(1);
        root.left = new TreeNode(2);
        root.right = new TreeNode(3);
        
        List<List<Integer>> result = printLevelOrderTraversal(root);
        System.out.println("Level Order Traversal: " + result);
    }
}
