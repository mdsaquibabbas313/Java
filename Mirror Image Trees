import java.util.*;

class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;

    TreeNode(int val) {
        this.val = val;
        this.left = null;
        this.right = null;
    }
}
public class Main {
    public static boolean checkIfRootAreMirrorImage(TreeNode root1 , TreeNode root2) {

        if(root1 == null && root2 == null) return true; 
        if(root1 == null || root2 == null) return false;

        boolean firstLeftSecondRightMatch = checkIfRootAreMirrorImage(root1.left , root2.right);
        boolean firstRightSecondLeftMatch = checkIfRootAreMirrorImage(root1.right , root2.left);

        if(root1.val == root2.val && firstLeftSecondRightMatch && firstRightSecondLeftMatch){
          return true;
        } else {
          return false;
        }
    }
    public static void main(String[] args) {
        // Constructing root1 (preOrder: 1, 2, 4, 5, 3)
        //      1
        //     / \
        //    2   3
        //   / \
        //  4   5
        TreeNode root1 = new TreeNode(1);
        root1.left = new TreeNode(2);
        root1.right = new TreeNode(3);
        root1.left.left = new TreeNode(4);
        root1.left.right = new TreeNode(5);

        // Constructing root2 as a mirror image of root1
        //      1
        //     / \
        //    3   2
        //       / \
        //      5   4
        TreeNode root2 = new TreeNode(1);
        root2.left = new TreeNode(3);
        root2.right = new TreeNode(2);
        root2.right.left = new TreeNode(5);
        root2.right.right = new TreeNode(4);

        boolean result = checkIfRootAreMirrorImage(root1, root2);
        System.out.println("Are root1 and root2 mirror images? " + result);
    }
}
