    // SOLUTION - 4 : O(N) Time & O(1) Space

    public static List<Integer> findElementsTwice(int[] arr) {
    List<Integer> result = new ArrayList<>();
    
    int n = arr.length;

    for (int i = 0; i < n; i++) {
        // Step 1: Always use absolute value because previous iterations 
        // might have flipped this number to negative.
        int value = Math.abs(arr[i]);

        // Step 2: Map 1-to-N human numbers down to 0-to-(N-1) array indices.
        int matchIdx = value - 1;

        // Step 3: If the locker at this index is already negative, 
        // it means we've visited this number before -> It's a duplicate!
        if (arr[matchIdx] < 0) {
            result.add(value);
        } else {
            // Step 4: Otherwise, mark it as visited by flipping it to negative.
            arr[matchIdx] = -arr[matchIdx];
        }
    }
    
    return result;
}

    public static void main(String[] args) {
        // Example array where elements are between 1 and N
        int[] arr = {2, 3, 4, 2, 3};
        
        System.out.println("Given array: " + Arrays.toString(arr));
        
        List<Integer> ans = findElementsTwice(arr);
        
        System.out.println("Elements occurring twice: " + ans);
    }
