class Solution {

    public static boolean isPurePalindrome(String str , int i , int j) {

        while(i <= j) {
            if(str.charAt(i) != str.charAt(j)) {
                return false;
            }
            i++;j--;
        }      

        return true;

    }

    public static boolean checkValidPallindrom(String str, int i, int j) {
        // Base condition
        if (i >= j) {
            return true;
        }

        // Main logic
        if (str.charAt(i) == str.charAt(j)) {
            return checkValidPallindrom(str, i + 1, j - 1);
        } else {
            return isPurePalindrome(str, i + 1, j) || isPurePalindrome(str, i, j - 1);
        }
    }

    public boolean validPalindrome(String s) {
        return checkValidPallindrom(s, 0, s.length() - 1);
    }
}
